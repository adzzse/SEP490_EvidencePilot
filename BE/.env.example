# Database
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=evidence_pilot
MYSQL_USER=evidencepilot
MYSQL_PASSWORD=
DB_PORT_HOST=3307

# Seed accounts (leave required fields blank to skip that account)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
STUDENT_EMAIL=
STUDENT_PASSWORD=
STUDENT_FIRST_NAME=Test
STUDENT_LAST_NAME=Student
STUDENT_CODE=SE000001
INSTRUCTOR_EMAIL=
INSTRUCTOR_PASSWORD=
INSTRUCTOR_FIRST_NAME=Test
INSTRUCTOR_LAST_NAME=Instructor

# Backend auth
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Public backend URL used in model-service document download links
APP_BASE_URL=http://127.0.0.1:8080

# Python model service
# Free ngrok tunnels throttle to ~20 req/min (HTTP 429). For local dev prefer
# AI_MODEL_BASE_URL=http://host.docker.internal:8000 over an ngrok tunnel.
AI_MODEL_BASE_URL=
AI_MODEL_API_KEY=
AI_MODEL_READ_TIMEOUT_SECONDS=660
AI_MODEL_MAX_RETRIES=5

# Qdrant
QDRANT_URL=http://vector-db:6333
QDRANT_API_KEY=
QDRANT_PORT_HOST=6333

# MinIO
MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=evidence-pilot-bucket

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Management UI (http://localhost:15672) shown as a link in the Admin extraction queue
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# Password reset email
PASSWORD_RESET_URL=
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# Set-password invitation link (required for user creation/import emails)
APP_INVITATION_URL=http://localhost:5173/set-password
APP_INVITATION_TTL_HOURS=24

# Dev-only user-creation bypass: fixed password, no email sent. BE additionally
# requires the dev Spring profile — keep false everywhere except local dev.
APP_DEV_BYPASS_ENABLED=false

# Host ports
BACKEND_PORT_HOST=8080
